# Copy this file to .env and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API). Never commit .env.

# --- App (public, bundled into the app) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Seed script only (scripts/seed.mjs). NEVER prefix these with EXPO_PUBLIC_ ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional: lets the seed script enrich films_cache with posters/cast. Not used by the app.
TMDB_API_KEY=YOUR_TMDB_API_KEY_OR_READ_ACCESS_TOKEN

# The TMDB key for the app is set as an edge-function secret instead:
#   npx supabase secrets set TMDB_API_KEY=...
